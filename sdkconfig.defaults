# CAN Opener SE: ESP32-C5-WROOM-1 (Rev.B docs say N16R8; earlier units are N8R8).
# Build for 8 MB so the same image runs on both; the app needs under 1.5 MB.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The USB-C port (USB Serial/JTAG) carries the binary wired protocol for
# VW_Flash, so nothing else may print to it: no console, no app logs, no
# bootloader logs. The ROM still prints a boot banner after a reset; that can
# only be turned off by burning an eFuse, which we don't do.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# Bluetooth LE via Bluedroid, GATT server, legacy (4.2) advertising APIs as used by ble_server.c
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_STACK_NO_LOG=y
CONFIG_BT_BTC_TASK_STACK_SIZE=3072
CONFIG_BT_BTU_TASK_STACK_SIZE=4096

# Matches the original firmware
CONFIG_PM_ENABLE=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
# 250 Hz like the original: ble_server.c uses app-set BLE delays as raw tick counts
CONFIG_FREERTOS_HZ=250
